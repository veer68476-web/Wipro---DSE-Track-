2. Using Set Operators (Department Salary, Job Salary, Total Salary)
SQL>SELECT TO_CHAR(DEPTNO) AS TYPE,
       TO_CHAR(SUM(SAL)) AS TOTAL_SALARY
FROM EMP
GROUP BY DEPTNO

UNION ALL

SELECT JOB,
       TO_CHAR(SUM(SAL))
FROM EMP
GROUP BY JOB

UNION ALL

SELECT 'TOTAL',
       TO_CHAR(SUM(SAL))
FROM EMP;
----------------------------------------------------------------------------------------------------------
output:-
