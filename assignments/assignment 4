8. Employees Hired in 1980, 1981 and 1982
SQL>SELECT COUNT(*) TOTAL_EMPLOYEES,
       SUM(CASE
             WHEN TO_CHAR(HIREDATE,'YYYY')='1980'
             THEN 1
             ELSE 0
           END) "1980",
       SUM(CASE
             WHEN TO_CHAR(HIREDATE,'YYYY')='1981'
             THEN 1
             ELSE 0
           END) "1981",
       SUM(CASE
             WHEN TO_CHAR(HIREDATE,'YYYY')='1982'
             THEN 1
             ELSE 0
           END) "1982"
FROM EMP;
---------------------------------------------------------------------------------------------------------
OUTPUT:-
TOTAL_EMPLOYEES 1980 1981 1982
--------------- ---- ---- ----
             14    1   12    1

1 row selected.
