4. Employees Starting with J, A or M
SQL>
SELECT INITCAP(ENAME) AS EMPLOYEE_NAME,
       LENGTH(ENAME) AS NAME_LENGTH
FROM EMP
WHERE ENAME LIKE 'J%'
   OR ENAME LIKE 'A%'
   OR ENAME LIKE 'M%'
ORDER BY ENAME;
--------------------------------------------------------------------------------
